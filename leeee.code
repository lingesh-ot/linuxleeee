9. JAVAFX BUTTON CONTROL
Filename: ButtonTest.java
============================================================

import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.StackPane;
import javafx.stage.Stage;

public class ButtonTest extends Application {
    @Override
    public void start(Stage primaryStage) {
        StackPane root = new StackPane();
        Button button = new Button("This is a button");
        root.getChildren().add(button);

        Scene scene = new Scene(root, 300, 300);
        primaryStage.setScene(scene);
        primaryStage.setTitle("Button Class Example");
        primaryStage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}

Expected result:
A 300 x 300 JavaFX window opens with a button labelled "This is a button".
(JavaFX GUI programs do not print a console output by default.)

