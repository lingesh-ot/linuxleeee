OBJECT ORIENTED PROGRAMMING LAB MANUAL
Corrected Java Programs and Expected Outputs

IMPORTANT:
- Save each program using the exact filename shown.
- For ordinary Java programs: javac FileName.java, then java ClassName
- JavaFX programs require JavaFX libraries and appropriate JavaFX setup. JavaFX is not bundled with most modern JDKs.
- Outputs below match the code and sample inputs shown.

============================================================
1. LINEAR SEARCH
Filename: LinearSearch.java
============================================================

public class LinearSearch {
    public static int linearSearch(int[] arr, int key) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == key) {
                return i;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 50, 70, 90};
        int key = 50;
        int index = linearSearch(arr, key);

        if (index != -1) {
            System.out.println(key + " is found at index: " + index);
        } else {
            System.out.println(key + " is not found");
        }
    }
}

Expected output:
50 is found at index: 3

============================================================
2. BINARY SEARCH
Filename: BinarySearch.java
============================================================

public class BinarySearch {
    public static int binarySearch(int[] arr, int key) {
        int first = 0;
        int last = arr.length - 1;

        while (first <= last) {
            int mid = first + (last - first) / 2;

            if (arr[mid] == key) {
                return mid;
            } else if (arr[mid] < key) {
                first = mid + 1;
            } else {
                last = mid - 1;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40, 50}; // Must be sorted
        int key = 30;
        int index = binarySearch(arr, key);

        if (index != -1) {
            System.out.println("Element is found at index: " + index);
        } else {
            System.out.println("Element is not found!");
        }
    }
}

Expected output:
Element is found at index: 2

