-- =====================================================
-- EX NO 4: DIFFERENT TYPES OF OPERATORS IN SQL
-- =====================================================
CREATE TABLE numbers (num1 INT, num2 INT);
INSERT INTO numbers VALUES (5, 10), (15, 20);

-- Arithmetic
SELECT num1, num2, num1 + num2 AS sum FROM numbers;
SELECT num1, num2, num1 - num2 AS difference FROM numbers;
SELECT num1, num2, num1 * num2 AS product FROM numbers;
SELECT num1, num2, num1 / num2 AS quotient FROM numbers;
SELECT num1, num2, num1 % num2 AS remainder FROM numbers;
SELECT num1, num2, POWER(num1, 2) AS power FROM numbers;

-- Logical
SELECT * FROM numbers WHERE num1 > 5 AND num2 > 10;
SELECT * FROM numbers WHERE num1 = 5 OR num2 = 20;

-- Comparison
SELECT * FROM numbers WHERE num1 = 5;
SELECT * FROM numbers WHERE num1 != 5;
SELECT * FROM numbers WHERE num1 <> 5;
SELECT * FROM numbers WHERE num1 > 5;
SELECT * FROM numbers WHERE num1 < 15;
SELECT * FROM numbers WHERE num1 >= 15;
SELECT * FROM numbers WHERE num1 <= 5;

-- OUTPUT:
-- sum: 15, 35 | difference: -5, -5 | product: 50, 300
-- quotient: 0.5000, 0.7500 | remainder: 5, 15 | power: 25, 225
-- AND -> (15,20) | OR -> (5,10) and (15,20)
-- =5 -> (5,10) | !=5 and <>5 -> (15,20) | >5 -> (15,20)
-- <15 -> (5,10) | >=15 -> (15,20) | <=5 -> (5,10)



-- =====================================================
-- EX NO 5: JOINS
-- =====================================================
CREATE TABLE t1 (id INT PRIMARY KEY, pattern VARCHAR(50) NOT NULL);
CREATE TABLE t2 (id VARCHAR(50) PRIMARY KEY, pattern VARCHAR(50) NOT NULL);
INSERT INTO t1 VALUES (1,'divot'), (2,'brick'), (3,'grid');
INSERT INTO t2 VALUES ('a','brick'), ('b','grid'), ('c','diamond');

-- CROSS JOIN
SELECT t1.id, t2.id FROM t1 CROSS JOIN t2;

-- INNER JOIN
SELECT t1.id, t2.id FROM t1 INNER JOIN t2 ON t1.pattern = t2.pattern;

-- LEFT JOIN
SELECT t1.id, t2.id FROM t1 LEFT JOIN t2
ON t1.pattern = t2.pattern ORDER BY t1.id;

-- RIGHT JOIN
SELECT t1.id, t2.id FROM t1 RIGHT JOIN t2
ON t1.pattern = t2.pattern ORDER BY t2.id;

-- SELF JOIN
SELECT a.id, b.id FROM t1 a JOIN t1 b ON a.id < b.id;

-- OUTPUT:
-- CROSS : 9 rows (every t1.id with a, b, c)
-- INNER : (2,a) (3,b)
-- LEFT  : (1,NULL) (2,a) (3,b)
-- RIGHT : (2,a) (3,b) (NULL,c)
-- SELF  : (1,2) (1,3) (2,3)



-- =====================================================
-- EX NO 6: NESTED QUERIES / SUB QUERIES
-- =====================================================
CREATE TABLE sempls (
  eno INT PRIMARY KEY,
  ename VARCHAR(20),
  edob VARCHAR(15),
  gender VARCHAR(10),
  doj VARCHAR(15),
  desg VARCHAR(30),
  bpay NUMERIC(10),
  dno NUMERIC(10)
);
INSERT INTO sempls VALUES
(1,'bala','15/1/84','m','16thJuly','lec',7000,1),
(2,'kala','13/9/84','m','18thJuly','lec',10000,2),
(3,'mala','17/6/85','f','19thJune','lec',19000,1),
(4,'nila','20/6/85','f','19thJune','sr.lec',20000,1),
(5,'vina','2/1/85','f','12thJuly','prof.',50000,2);

CREATE TABLE sdments (dno INT PRIMARY KEY, dname VARCHAR(30));
INSERT INTO sdments VALUES (1,'cse'), (2,'it');

CREATE TABLE spros (pno INT PRIMARY KEY, pname VARCHAR(30), dno INT);
INSERT INTO spros VALUES
(81,'aaa',1),(82,'bbb',1),(83,'ccc',1),(84,'ddd',2),(85,'eee',2);

CREATE TABLE sworks (
  eno INT,
  pno INT,
  datework VARCHAR(20),
  intime INT,
  outtime INT,
  PRIMARY KEY (eno, pno, datework)
);
INSERT INTO sworks VALUES
(1,81,'11thJuly',9,10),
(1,82,'11thJuly',10,11),
(1,83,'11thJuly',11,12),
(1,84,'11thJuly',12,1),
(1,85,'11thJuly',1,2),
(2,85,'12thJuly',8,9);

-- Q1: basic pay less than average
SELECT * FROM sempls WHERE bpay < (SELECT AVG(bpay) FROM sempls);

-- Q2: employees per department
SELECT dno, COUNT(eno) FROM sempls GROUP BY dno;

-- Q3: basic pay between 10000 and 20000
SELECT * FROM sempls WHERE bpay BETWEEN 10000 AND 20000;

-- Q4: employees in projects controlled by 'cse'
SELECT DISTINCT e.eno, e.ename
FROM sempls e
WHERE e.dno IN (SELECT dno FROM sdments WHERE dname = 'cse');

-- Q5: employees who worked on more than 4 projects in a single day
SELECT eno, ename, dno FROM sempls
WHERE eno IN (
  SELECT eno FROM sworks
  GROUP BY eno, datework
  HAVING COUNT(pno) > 4
);

-- OUTPUT:
-- Q1: eno 1, 2, 3, 4 (average pay is 21200)
-- Q2: dno 1 -> 3, dno 2 -> 2
-- Q3: eno 2, 3, 4
-- Q4: eno 1, 3, 4
-- Q5: eno 1 (bala)



-- =====================================================
-- EX NO 7: PATTERN MATCHING
-- =====================================================
CREATE TABLE Products2 (
  product_id INT PRIMARY KEY,
  product_name VARCHAR(50) NOT NULL
);
INSERT INTO Products2 VALUES
(1,'Samsung Phone'),(2,'Sony TV'),(3,'Apple Watch'),
(4,'Cat Toy'),(5,'Cute Doll'),(6,'Ace Game');

SELECT * FROM Products2 WHERE product_name LIKE 'S%';
SELECT * FROM Products2 WHERE product_name LIKE '%apple%';
SELECT * FROM Products2 WHERE product_name LIKE 'C_t%';
SELECT * FROM Products2 WHERE product_name LIKE 'A%e';

SELECT * FROM Products2 WHERE product_name REGEXP '^S';
SELECT * FROM Products2 WHERE product_name REGEXP 'e$';
SELECT * FROM Products2 WHERE product_name REGEXP 'o+';
SELECT * FROM Products2 WHERE product_name REGEXP '[0-9]';

-- OUTPUT:
-- LIKE 'S%'      -> Samsung Phone, Sony TV
-- LIKE '%apple%' -> Apple Watch
-- LIKE 'C_t%'    -> Cat Toy, Cute Doll
-- LIKE 'A%e'     -> Ace Game
-- REGEXP '^S'    -> Samsung Phone, Sony TV
-- REGEXP 'e$'    -> Samsung Phone, Ace Game
-- REGEXP 'o+'    -> Samsung Phone, Sony TV, Cat Toy, Cute Doll
-- REGEXP '[0-9]' -> Empty set



-- =====================================================
-- EX NO 8: CONSTRAINTS
-- =====================================================
CREATE TABLE Students (
  student_id INT PRIMARY KEY,
  student_name VARCHAR(50) NOT NULL,
  email VARCHAR(100) UNIQUE,
  age INT CHECK (age >= 18),
  course VARCHAR(50) DEFAULT 'B.Tech'
);
INSERT INTO Students VALUES
(1,'Arun','arun@gmail.com',20,'B.Tech'),
(2,'Priya','priya@gmail.com',21,DEFAULT),
(3,'Karthik','karthik@gmail.com',19,'B.Sc');
SELECT * FROM Students;

CREATE TABLE Departments (
  dept_id INT PRIMARY KEY,
  dept_name VARCHAR(50) NOT NULL
);
INSERT INTO Departments VALUES
(101,'Computer Science'),(102,'Electronics'),(103,'Mechanical'),(104,'Civil');

CREATE TABLE Faculty (
  faculty_id INT PRIMARY KEY,
  faculty_name VARCHAR(50) NOT NULL,
  dept_id INT,
  FOREIGN KEY (dept_id) REFERENCES Departments(dept_id)
);
INSERT INTO Faculty VALUES
(1,'Dr. Ramesh',101),(2,'Dr. Priya',102),(3,'Dr. Karthik',101),(4,'Dr. Anitha',104);
SELECT * FROM Faculty;

-- Violation tests (each should give an error, except the 5th)
INSERT INTO Faculty VALUES (5,'Dr. Test',999);
INSERT INTO Students VALUES (4,'Ravi','ravi@gmail.com',15,'B.Tech');
INSERT INTO Students VALUES (5,'Ravi',NULL,20,'B.Tech');
INSERT INTO Students VALUES (6,NULL,'x@gmail.com',20,'B.Tech');
INSERT INTO Students VALUES (1,'Dup','d@gmail.com',20,'B.Tech');

-- OUTPUT:
-- Students: (1 Arun 20 B.Tech) (2 Priya 21 B.Tech) (3 Karthik 19 B.Sc)
-- Faculty : (1,101) (2,102) (3,101) (4,104)
-- Faculty dept 999 -> ERROR 1452: foreign key constraint fails
-- age 15           -> ERROR 3819: Check constraint is violated
-- email NULL       -> succeeds (UNIQUE allows NULL)
-- name NULL        -> ERROR 1048: Column 'student_name' cannot be null
-- duplicate id 1   -> ERROR 1062: Duplicate entry '1' for key 'students.PRIMARY'



-- =====================================================
-- EX NO 9: FUNCTIONS
-- =====================================================
CREATE TABLE it (ID INT, Name VARCHAR(20), Dept INT);
INSERT INTO it VALUES (101,'xxx',4021),(102,'yyy',4031),(103,'yyy',4021);
SELECT * FROM it;

CREATE FUNCTION Hi(eid INT)
RETURNS CHAR(40)
DETERMINISTIC
RETURN 'Super';

SELECT dept, Hi(101) FROM it;

DELIMITER //
CREATE FUNCTION Factorial(n INT)
RETURNS INT
DETERMINISTIC
BEGIN
  DECLARE fact INT DEFAULT 1;
  IF n <= 0 THEN
    RETURN 1;
  END IF;
  factorial_loop: LOOP
    SET fact = fact * n;
    SET n = n - 1;
    IF n < 1 THEN
      LEAVE factorial_loop;
    END IF;
  END LOOP factorial_loop;
  RETURN fact;
END //
DELIMITER ;

SELECT Factorial(5);

-- OUTPUT:
-- dept  Hi(101)
-- 4021  Super
-- 4031  Super
-- 4021  Super
-- Factorial(5) = 120



-- =====================================================
-- EX NO 10: STORED PROCEDURES
-- =====================================================
CREATE TABLE item (
  ITEMID INT, ACTUALPRICE INT, ORDID INT, PRODID INT
);
INSERT INTO item VALUES (101,2500,500,201),(102,3000,1600,202),(103,4000,600,203);
SELECT * FROM item;

DELIMITER //

CREATE PROCEDURE func_in(IN a INT)
BEGIN
  SELECT actualprice FROM item WHERE itemid = a;
END //

CREATE PROCEDURE func_out(IN price INT, OUT Total_count INT)
BEGIN
  SELECT COUNT(*) INTO Total_count FROM item WHERE actualprice < price;
END //

CREATE PROCEDURE func_inout(INOUT cnt INT, IN inc INT)
BEGIN
  SET cnt = cnt + inc;
END //

DELIMITER ;

CALL func_in(101);

CALL func_out(4000, @Total_count);
SELECT @Total_count;

SET @counter = 1;
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 5);
SELECT @counter;

-- OUTPUT:
-- func_in(101)  -> actualprice = 2500
-- @Total_count  -> 2
-- @counter      -> 8



-- =====================================================
-- EX NO 11: TRANSACTIONS, DCL AND TCL COMMANDS
-- =====================================================
CREATE TABLE Account (
  AccNo INT PRIMARY KEY,
  Name VARCHAR(30),
  Balance INT
);
INSERT INTO Account VALUES (101,'Arun',5000);
INSERT INTO Account VALUES (102,'Bala',7000);
INSERT INTO Account VALUES (103,'Charan',8000);
SELECT * FROM Account;

START TRANSACTION;
UPDATE Account SET Balance = Balance - 1000 WHERE AccNo = 101;
SAVEPOINT S1;
UPDATE Account SET Balance = Balance + 1000 WHERE AccNo = 102;
SAVEPOINT S2;
DELETE FROM Account WHERE AccNo = 103;
ROLLBACK TO S1;
COMMIT;
SELECT * FROM Account;

-- DCL (run as root)
CREATE USER 'student'@'localhost' IDENTIFIED BY 'stud123';
GRANT SELECT, INSERT ON dbms_lab.Account TO 'student'@'localhost';
SHOW GRANTS FOR 'student'@'localhost';
REVOKE INSERT ON dbms_lab.Account FROM 'student'@'localhost';
SHOW GRANTS FOR 'student'@'localhost';

-- OUTPUT (after COMMIT):
-- 101  Arun    4000  (deduction kept)
-- 102  Bala    7000  (update rolled back)
-- 103  Charan  8000  (delete rolled back)
-- After GRANT : GRANT SELECT, INSERT ON `dbms_lab`.`Account` TO `student`@`localhost`
-- After REVOKE: GRANT SELECT ON `dbms_lab`.`Account` TO `student`@`localhost`



-- =====================================================
-- EX NO 12: SQL TRIGGERS (INSERT, DELETE, UPDATE)
-- =====================================================
CREATE TABLE Employee (
  EmpID INT PRIMARY KEY,
  Name VARCHAR(30),
  Salary INT
);
CREATE TABLE Emp_Log (
  LogID INT AUTO_INCREMENT PRIMARY KEY,
  Action VARCHAR(20),
  EmpID INT,
  Name VARCHAR(30),
  ActionTime TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER after_employee_insert
AFTER INSERT ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('INSERT', NEW.EmpID, NEW.Name);

CREATE TRIGGER after_employee_delete
AFTER DELETE ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('DELETE', OLD.EmpID, OLD.Name);

CREATE TRIGGER after_employee_update
AFTER UPDATE ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('UPDATE', NEW.EmpID, NEW.Name);

INSERT INTO Employee VALUES (101,'Arun',30000);
DELETE FROM Employee WHERE EmpID = 101;
INSERT INTO Employee VALUES (102,'Bala',35000);
UPDATE Employee SET Salary = 40000 WHERE EmpID = 102;

SELECT * FROM Emp_Log;

-- OUTPUT (ActionTime will show your current time):
-- LogID  Action  EmpID  Name  ActionTime
-- 1      INSERT  101    Arun  2026-10-28 10:15:00
-- 2      DELETE  101    Arun  2026-10-28 10:20:00
-- 3      INSERT  102    Bala  2026-10-28 10:25:00
-- 4      UPDATE  102    Bala  2026-10-28 10:27:00
