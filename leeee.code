5. INTERFACE AND ABSTRACT CLASS: AREA OF SHAPES
Filename: Main.java
============================================================

interface AreaCalculable {
    double calculateArea();
}

abstract class Shape {
    protected int length;
    protected int width;

    public Shape(int length, int width) {
        this.length = length;
        this.width = width;
    }

    public abstract void printArea();
}

class Rectangle extends Shape implements AreaCalculable {
    public Rectangle(int length, int width) {
        super(length, width);
    }

    @Override
    public double calculateArea() {
        return (double) length * width;
    }

    @Override
    public void printArea() {
        System.out.println("Area of Rectangle: " + calculateArea());
    }
}

class Triangle extends Shape implements AreaCalculable {
    public Triangle(int base, int height) {
        super(base, height);
    }

    @Override
    public double calculateArea() {
        return 0.5 * length * width;
    }

    @Override
    public void printArea() {
        System.out.println("Area of Triangle: " + calculateArea());
    }
}

class Circle extends Shape implements AreaCalculable {
    public Circle(int radius) {
        super(radius, radius);
    }

    @Override
    public double calculateArea() {
        return Math.PI * length * length;
    }

    @Override
    public void printArea() {
        System.out.println("Area of Circle: " + calculateArea());
    }
}

public class Main {
    public static void main(String[] args) {
        Rectangle rectangle = new Rectangle(5, 4);
        rectangle.printArea();

        Triangle triangle = new Triangle(6, 8);
        triangle.printArea();

        Circle circle = new Circle(3);
        circle.printArea();
    }
}

Expected output:
Area of Rectangle: 20.0
Area of Triangle: 24.0
Area of Circle: 28.274333882308138

