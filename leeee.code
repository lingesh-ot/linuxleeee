8. GENERIC FUNCTION TO FIND MAXIMUM
Filename: A.java
============================================================

public class A {
    @SafeVarargs
    public static <T extends Comparable<? super T>> T max(T... elements) {
        if (elements == null || elements.length == 0) {
            throw new IllegalArgumentException("At least one element is required");
        }

        T maximum = elements[0];
        for (T element : elements) {
            if (element.compareTo(maximum) > 0) {
                maximum = element;
            }
        }
        return maximum;
    }

    public static void main(String[] args) {
        System.out.println("Integer Max: " + max(32, 56, 89, 3, 456, 78, 45));
        System.out.println("Double Max: " + max(5.6, 7.8, 2.9, 18.6, 10.25, 18.6001));
        System.out.println("String Max: " + max("Strawberry", "Mango", "Apple",
                "Pomegranate", "Guava", "Blackberry", "Cherry", "Orange", "Date"));
        System.out.println("Boolean Max: " + max(true, false));
        System.out.println("Byte Max: " + max(Byte.MIN_VALUE, Byte.MAX_VALUE));
    }
}

Expected output:
Integer Max: 456
Double Max: 18.6001
String Max: Strawberry
Boolean Max: true
Byte Max: 127

