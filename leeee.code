-- =====================================================
-- SETUP
-- =====================================================
CREATE DATABASE dbms_lab;
USE dbms_lab;



-- =====================================================
-- EX NO 1: DATA DEFINITION COMMANDS
-- =====================================================
CREATE TABLE stud (
  sname VARCHAR(30),
  sid VARCHAR(10),
  sage INT,
  sarea VARCHAR(20)
);
SHOW TABLES;
DESC stud;
ALTER TABLE stud ADD phoneno INT AFTER sage;
DESC stud;
ALTER TABLE stud MODIFY sage VARCHAR(20);
DESC stud;
ALTER TABLE stud DROP COLUMN sage;
DESC stud;
TRUNCATE TABLE stud;
DESC stud;
DROP TABLE stud;
DESC stud;

-- OUTPUT:
-- After ADD     : sname, sid, sage, phoneno, sarea
-- After MODIFY  : sage becomes varchar(20)
-- After DROP COL: sname, sid, phoneno, sarea
-- After TRUNCATE: same structure, no records
-- After DROP    : ERROR 1146 (42S02): Table 'dbms_lab.stud' doesn't exist



-- =====================================================
-- EX NO 2: DATA MANIPULATION COMMANDS
-- =====================================================
CREATE TABLE student (
  sn CHAR(20),
  regno INT,
  address VARCHAR(40)
);
INSERT INTO student (sn, regno, address) VALUES
('shalini', 1001, 'second street, chennai-73'),
('vinosha', 1002, 'kurinji street, chennai-73'),
('bharani', 1003, 'first street, chennai-73');
SELECT * FROM student;

ALTER TABLE student ADD sid INT;
UPDATE student SET sid = 1 WHERE regno = 1001;
UPDATE student SET sid = 2 WHERE regno = 1002;
UPDATE student SET sid = 3 WHERE regno = 1003;
SELECT * FROM student;

SELECT * FROM student WHERE regno = 1001;
SELECT * FROM student WHERE regno = 1001 OR sid = 2;
SELECT * FROM student WHERE regno NOT IN (1001, 1002);

DELETE FROM student WHERE sid = 1;
SELECT * FROM student;

-- OUTPUT (after update):
-- shalini  1001  second street, chennai-73   1
-- vinosha  1002  kurinji street, chennai-73  2
-- bharani  1003  first street, chennai-73    3
-- regno=1001            -> shalini
-- regno=1001 OR sid=2   -> shalini, vinosha
-- NOT IN (1001,1002)    -> bharani
-- OUTPUT (after delete):
-- vinosha  1002  kurinji street, chennai-73  2
-- bharani  1003  first street, chennai-73    3



