## EX.NO: 1 – DATA DEFINITION COMMANDS

```sql
CREATE DATABASE a;
USE a;

CREATE TABLE stud (
    sname VARCHAR(30),
    sid VARCHAR(10),
    sage INT,
    sarea VARCHAR(20)
);

SHOW TABLES;
DESC stud;

ALTER TABLE stud ADD phoneno INT AFTER sage;
DESC stud;

ALTER TABLE stud MODIFY sage VARCHAR(20);
DESC stud;

ALTER TABLE stud DROP sage;
DESC stud;

TRUNCATE TABLE stud;
DROP TABLE stud;
DESC stud;

