-- #####################################################
-- EX NO 4: DIFFERENT TYPES OF OPERATORS IN SQL
-- #####################################################
SELECT '===== EX 4: OPERATORS =====' AS Experiment;
DROP TABLE IF EXISTS numbers;

CREATE TABLE numbers (num1 INT, num2 INT);
INSERT INTO numbers VALUES (5, 10), (15, 20);
SELECT * FROM numbers;

-- Arithmetic operators
SELECT num1, num2,
       num1 + num2 AS sum,
       num1 - num2 AS difference,
       num1 * num2 AS product,
       num1 / num2 AS quotient,
       num1 % num2 AS remainder,
       POWER(num1, 2) AS power
FROM numbers;

-- Logical operators
SELECT * FROM numbers WHERE num1 > 5 AND num2 > 10;
SELECT * FROM numbers WHERE num1 = 5 OR num2 = 20;

-- Comparison operators
SELECT * FROM numbers WHERE num1 = 5;
SELECT * FROM numbers WHERE num1 != 5;
SELECT * FROM numbers WHERE num1 <> 5;
SELECT * FROM numbers WHERE num1 > 5;
SELECT * FROM numbers WHERE num1 < 15;
SELECT * FROM numbers WHERE num1 >= 15;
SELECT * FROM numbers WHERE num1 <= 5;

-- OUTPUT: Arithmetic
-- +------+------+------+------------+---------+----------+-----------+-------+
-- | num1 | num2 | sum  | difference | product | quotient | remainder | power |
-- +------+------+------+------------+---------+----------+-----------+-------+
-- |    5 |   10 |   15 |         -5 |      50 |   0.5000 |         5 |    25 |
-- |   15 |   20 |   35 |         -5 |     300 |   0.7500 |        15 |   225 |
-- +------+------+------+------------+---------+----------+-----------+-------+
-- OUTPUT: AND -> (15,20)
-- OUTPUT: OR  -> (5,10) and (15,20)
-- OUTPUT: =5, <15, <=5 -> (5,10)
-- OUTPUT: !=5, <>5, >5, >=15 -> (15,20)



-- #####################################################
-- EX NO 5: JOINS
-- #####################################################
SELECT '===== EX 5: JOINS =====' AS Experiment;
DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;

CREATE TABLE t1 (id INT PRIMARY KEY, pattern VARCHAR(50) NOT NULL);
CREATE TABLE t2 (id VARCHAR(50) PRIMARY KEY, pattern VARCHAR(50) NOT NULL);
INSERT INTO t1 VALUES (1,'divot'), (2,'brick'), (3,'grid');
INSERT INTO t2 VALUES ('a','brick'), ('b','grid'), ('c','diamond');
SELECT * FROM t1;
SELECT * FROM t2;

-- CROSS JOIN
SELECT t1.id AS t1_id, t2.id AS t2_id
FROM t1 CROSS JOIN t2 ORDER BY t1.id, t2.id;

-- INNER JOIN
SELECT t1.id AS t1_id, t2.id AS t2_id
FROM t1 INNER JOIN t2 ON t1.pattern = t2.pattern;

-- LEFT JOIN
SELECT t1.id AS t1_id, t2.id AS t2_id
FROM t1 LEFT JOIN t2 ON t1.pattern = t2.pattern ORDER BY t1.id;

-- RIGHT JOIN
SELECT t1.id AS t1_id, t2.id AS t2_id
FROM t1 RIGHT JOIN t2 ON t1.pattern = t2.pattern ORDER BY t2.id;

-- SELF JOIN
SELECT a.id AS a_id, b.id AS b_id
FROM t1 a JOIN t1 b ON a.id < b.id;

-- OUTPUT: CROSS JOIN (9 rows)
-- +-------+-------+
-- | t1_id | t2_id |
-- +-------+-------+
-- |     1 | a     |
-- |     1 | b     |
-- |     1 | c     |
-- |     2 | a     |
-- |     2 | b     |
-- |     2 | c     |
-- |     3 | a     |
-- |     3 | b     |
-- |     3 | c     |
-- +-------+-------+
-- OUTPUT: INNER JOIN
-- +-------+-------+
-- |     2 | a     |
-- |     3 | b     |
-- +-------+-------+
-- OUTPUT: LEFT JOIN
-- +-------+-------+
-- |     1 | NULL  |
-- |     2 | a     |
-- |     3 | b     |
-- +-------+-------+
-- OUTPUT: RIGHT JOIN
-- +-------+-------+
-- |     2 | a     |
-- |     3 | b     |
-- |  NULL | c     |
-- +-------+-------+
-- OUTPUT: SELF JOIN
-- +------+------+
-- | a_id | b_id |
-- +------+------+
-- |    1 |    2 |
-- |    1 |    3 |
-- |    2 |    3 |
-- +------+------+



-- #####################################################
-- EX NO 6: NESTED QUERIES / SUB QUERIES
-- #####################################################
SELECT '===== EX 6: NESTED QUERIES =====' AS Experiment;
DROP TABLE IF EXISTS sworks;
DROP TABLE IF EXISTS spros;
DROP TABLE IF EXISTS sdments;
DROP TABLE IF EXISTS sempls;

CREATE TABLE sempls (
  eno INT PRIMARY KEY,
  ename VARCHAR(20),
  edob VARCHAR(15),
  gender VARCHAR(10),
  doj VARCHAR(15),
  desg VARCHAR(30),
  bpay NUMERIC(10),
  dno NUMERIC(10)
);
INSERT INTO sempls VALUES
(1,'bala','15/1/84','m','16thJuly','lec',7000,1),
(2,'kala','13/9/84','m','18thJuly','lec',10000,2),
(3,'mala','17/6/85','f','19thJune','lec',19000,1),
(4,'nila','20/6/85','f','19thJune','sr.lec',20000,1),
(5,'vina','2/1/85','f','12thJuly','prof.',50000,2);

CREATE TABLE sdments (dno INT PRIMARY KEY, dname VARCHAR(30));
INSERT INTO sdments VALUES (1,'cse'), (2,'it');

CREATE TABLE spros (pno INT PRIMARY KEY, pname VARCHAR(30), dno INT);
INSERT INTO spros VALUES
(81,'aaa',1),(82,'bbb',1),(83,'ccc',1),(84,'ddd',2),(85,'eee',2);

CREATE TABLE sworks (
  eno INT,
  pno INT,
  datework VARCHAR(20),
  intime INT,
  outtime INT,
  PRIMARY KEY (eno, pno, datework)
);
INSERT INTO sworks VALUES
(1,81,'11thJuly',9,10),
(1,82,'11thJuly',10,11),
(1,83,'11thJuly',11,12),
(1,84,'11thJuly',12,1),
(1,85,'11thJuly',1,2),
(2,85,'12thJuly',8,9);

SELECT * FROM sempls;
SELECT * FROM sdments;
SELECT * FROM spros;
SELECT * FROM sworks;

-- Q1: basic pay less than the average basic pay
SELECT * FROM sempls WHERE bpay < (SELECT AVG(bpay) FROM sempls);

-- Q2: department number and number of employees in each department
SELECT dno, COUNT(eno) AS total_employees FROM sempls GROUP BY dno;

-- Q3: basic pay between 10000 and 20000
SELECT * FROM sempls WHERE bpay BETWEEN 10000 AND 20000;

-- Q4: employees working in projects controlled by 'cse'
SELECT DISTINCT eno, ename FROM sempls
WHERE dno IN (SELECT dno FROM sdments WHERE dname = 'cse');

-- Q5: employees who worked in more than 4 projects on a single day
SELECT eno, ename, dno FROM sempls
WHERE eno IN (
  SELECT eno FROM sworks
  GROUP BY eno, datework
  HAVING COUNT(pno) > 4
);

-- OUTPUT: Q1 (average pay = 21200)
-- +-----+-------+---------+--------+----------+--------+-------+-----+
-- | eno | ename | edob    | gender | doj      | desg   | bpay  | dno |
-- +-----+-------+---------+--------+----------+--------+-------+-----+
-- |   1 | bala  | 15/1/84 | m      | 16thJuly | lec    |  7000 |   1 |
-- |   2 | kala  | 13/9/84 | m      | 18thJuly | lec    | 10000 |   2 |
-- |   3 | mala  | 17/6/85 | f      | 19thJune | lec    | 19000 |   1 |
-- |   4 | nila  | 20/6/85 | f      | 19thJune | sr.lec | 20000 |   1 |
-- +-----+-------+---------+--------+----------+--------+-------+-----+
-- OUTPUT: Q2
-- +-----+-----------------+
-- | dno | total_employees |
-- +-----+-----------------+
-- |   1 |               3 |
-- |   2 |               2 |
-- +-----+-----------------+
-- OUTPUT: Q3 -> eno 2 (kala), 3 (mala), 4 (nila)
-- OUTPUT: Q4
-- +-----+-------+
-- |   1 | bala  |
-- |   3 | mala  |
-- |   4 | nila  |
-- +-----+-------+
-- OUTPUT: Q5
-- +-----+-------+-----+
-- | eno | ename | dno |
-- +-----+-------+-----+
-- |   1 | bala  |   1 |
-- +-----+-------+-----+



-- #####################################################
-- EX NO 7: PATTERN MATCHING
-- #####################################################
SELECT '===== EX 7: PATTERN MATCHING =====' AS Experiment;
DROP TABLE IF EXISTS Products2;

CREATE TABLE Products2 (
  product_id INT PRIMARY KEY,
  product_name VARCHAR(50) NOT NULL
);
INSERT INTO Products2 VALUES
(1,'Samsung Phone'),(2,'Sony TV'),(3,'Apple Watch'),
(4,'Cat Toy'),(5,'Cute Doll'),(6,'Ace Game');
SELECT * FROM Products2;

-- LIKE operator
SELECT * FROM Products2 WHERE product_name LIKE 'S%';
SELECT * FROM Products2 WHERE product_name LIKE '%apple%';
SELECT * FROM Products2 WHERE product_name LIKE 'C_t%';
SELECT * FROM Products2 WHERE product_name LIKE 'A%e';

-- REGEXP operator
SELECT * FROM Products2 WHERE product_name REGEXP '^S';
SELECT * FROM Products2 WHERE product_name REGEXP 'e$';
SELECT * FROM Products2 WHERE product_name REGEXP 'o+';
SELECT * FROM Products2 WHERE product_name REGEXP '[0-9]';

-- OUTPUT: SELECT * FROM Products2
-- +------------+---------------+
-- | product_id | product_name  |
-- +------------+---------------+
-- |          1 | Samsung Phone |
-- |          2 | Sony TV       |
-- |          3 | Apple Watch   |
-- |          4 | Cat Toy       |
-- |          5 | Cute Doll     |
-- |          6 | Ace Game      |
-- +------------+---------------+
-- OUTPUT: LIKE 'S%' and REGEXP '^S' -> Samsung Phone, Sony TV
-- OUTPUT: LIKE '%apple%'            -> Apple Watch
-- OUTPUT: LIKE 'C_t%'               -> Cat Toy, Cute Doll
-- OUTPUT: LIKE 'A%e'                -> Ace Game
-- OUTPUT: REGEXP 'e$'               -> Samsung Phone, Ace Game
-- OUTPUT: REGEXP 'o+'               -> Samsung Phone, Sony TV, Cat Toy, Cute Doll
-- OUTPUT: REGEXP '[0-9]'            -> Empty set



-- #####################################################
-- EX NO 8: CONSTRAINTS
-- #####################################################
SELECT '===== EX 8: CONSTRAINTS =====' AS Experiment;
DROP TABLE IF EXISTS Faculty;
DROP TABLE IF EXISTS Departments;
DROP TABLE IF EXISTS Students;

CREATE TABLE Students (
  student_id INT PRIMARY KEY,
  student_name VARCHAR(50) NOT NULL,
  email VARCHAR(100) UNIQUE,
  age INT CHECK (age >= 18),
  course VARCHAR(50) DEFAULT 'B.Tech'
);
INSERT INTO Students VALUES
(1,'Arun','arun@gmail.com',20,'B.Tech'),
(2,'Priya','priya@gmail.com',21,DEFAULT),
(3,'Karthik','karthik@gmail.com',19,'B.Sc');
SELECT * FROM Students;

CREATE TABLE Departments (
  dept_id INT PRIMARY KEY,
  dept_name VARCHAR(50) NOT NULL
);
INSERT INTO Departments VALUES
(101,'Computer Science'),(102,'Electronics'),(103,'Mechanical'),(104,'Civil');
SELECT * FROM Departments;

CREATE TABLE Faculty (
  faculty_id INT PRIMARY KEY,
  faculty_name VARCHAR(50) NOT NULL,
  dept_id INT,
  FOREIGN KEY (dept_id) REFERENCES Departments(dept_id)
);
INSERT INTO Faculty VALUES
