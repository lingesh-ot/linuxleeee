-- #####################################################
-- SETUP
-- #####################################################
CREATE DATABASE IF NOT EXISTS dbms_lab;
USE dbms_lab;


-- #####################################################
-- EX NO 1: DATA DEFINITION COMMANDS
-- #####################################################
SELECT '===== EX 1: DDL COMMANDS =====' AS Experiment;
DROP TABLE IF EXISTS stud;

CREATE TABLE stud (
  sname VARCHAR(30),
  sid VARCHAR(10),
  sage INT,
  sarea VARCHAR(20)
);
DESC stud;
INSERT INTO stud VALUES ('arun','S101',20,'chennai');

ALTER TABLE stud ADD phoneno INT AFTER sage;
DESC stud;
ALTER TABLE stud MODIFY sage VARCHAR(20);
DESC stud;
ALTER TABLE stud DROP COLUMN sage;
DESC stud;
SELECT * FROM stud;
TRUNCATE TABLE stud;
SELECT * FROM stud;
DROP TABLE stud;
SHOW TABLES;

-- OUTPUT: DESC stud (after ADD phoneno)
-- +---------+-------------+------+-----+---------+-------+
-- | Field   | Type        | Null | Key | Default | Extra |
-- +---------+-------------+------+-----+---------+-------+
-- | sname   | varchar(30) | YES  |     | NULL    |       |
-- | sid     | varchar(10) | YES  |     | NULL    |       |
-- | sage    | int         | YES  |     | NULL    |       |
-- | phoneno | int         | YES  |     | NULL    |       |
-- | sarea   | varchar(20) | YES  |     | NULL    |       |
-- +---------+-------------+------+-----+---------+-------+
-- OUTPUT: after MODIFY -> sage becomes varchar(20)
-- OUTPUT: after DROP COLUMN
-- +---------+-------------+
-- | Field   | Type        |
-- +---------+-------------+
-- | sname   | varchar(30) |
-- | sid     | varchar(10) |
-- | phoneno | int         |
-- | sarea   | varchar(20) |
-- +---------+-------------+
-- OUTPUT: SELECT before TRUNCATE
-- +-------+------+---------+---------+
-- | sname | sid  | phoneno | sarea   |
-- +-------+------+---------+---------+
-- | arun  | S101 |    NULL | chennai |
-- +-------+------+---------+---------+
-- OUTPUT: after TRUNCATE -> Empty set
-- OUTPUT: after DROP TABLE -> Empty set (DESC stud would give ERROR 1146: Table doesn't exist)



-- #####################################################
-- EX NO 2: DATA MANIPULATION COMMANDS
-- #####################################################
SELECT '===== EX 2: DML COMMANDS =====' AS Experiment;
DROP TABLE IF EXISTS student;

CREATE TABLE student (
  sn CHAR(20),
  regno INT,
  address VARCHAR(40)
);
INSERT INTO student (sn, regno, address) VALUES
('shalini', 1001, 'second street, chennai-73'),
('vinosha', 1002, 'kurinji street, chennai-73'),
('bharani', 1003, 'first street, chennai-73');
SELECT * FROM student;

ALTER TABLE student ADD sid INT;
UPDATE student SET sid = 1 WHERE regno = 1001;
UPDATE student SET sid = 2 WHERE regno = 1002;
UPDATE student SET sid = 3 WHERE regno = 1003;
SELECT * FROM student;

SELECT * FROM student WHERE regno = 1001;
SELECT * FROM student WHERE regno = 1001 OR sid = 2;
SELECT * FROM student WHERE regno NOT IN (1001, 1002);

DELETE FROM student WHERE sid = 1;
SELECT * FROM student;

-- OUTPUT: after UPDATE
-- +---------+-------+----------------------------+------+
-- | sn      | regno | address                    | sid  |
-- +---------+-------+----------------------------+------+
-- | shalini |  1001 | second street, chennai-73  |    1 |
-- | vinosha |  1002 | kurinji street, chennai-73 |    2 |
-- | bharani |  1003 | first street, chennai-73   |    3 |
-- +---------+-------+----------------------------+------+
-- OUTPUT: regno = 1001 -> shalini
-- OUTPUT: regno = 1001 OR sid = 2 -> shalini, vinosha
-- OUTPUT: regno NOT IN (1001,1002) -> bharani
-- OUTPUT: after DELETE
-- +---------+-------+----------------------------+------+
-- | sn      | regno | address                    | sid  |
-- +---------+-------+----------------------------+------+
-- | vinosha |  1002 | kurinji street, chennai-73 |    2 |
-- | bharani |  1003 | first street, chennai-73   |    3 |
-- +---------+-------+----------------------------+------+



-- #####################################################
-- EX NO 3: WHERE CLAUSE AND AGGREGATE FUNCTIONS
-- #####################################################
SELECT '===== EX 3: WHERE CLAUSE AND AGGREGATE FUNCTIONS =====' AS Experiment;
DROP TABLE IF EXISTS Emp1;
DROP TABLE IF EXISTS Products;
DROP TABLE IF EXISTS Customers;

-- ---- Part A: WHERE clause ----
CREATE TABLE Emp1 (
  EmpID INT PRIMARY KEY,
  Name VARCHAR(50),
  Country VARCHAR(50),
  Age INT,
  mob INT
);
INSERT INTO Emp1 VALUES
(1, 'Shubham', 'India', 23, 738479734),
(2, 'Aman', 'Australia', 21, 436789555),
(3, 'Naveen', 'Sri lanka', 24, 34873847),
(4, 'Aditya', 'Austria', 21, 328440934),
(5, 'Nishant', 'Spain', 22, 73248679);

SELECT * FROM Emp1;
SELECT * FROM Emp1 WHERE Age = 24;
SELECT EmpID, Name, Country FROM Emp1 WHERE Age > 21;
SELECT * FROM Emp1 WHERE Age BETWEEN 22 AND 24;
SELECT * FROM Emp1 WHERE Name LIKE 'S%';
SELECT * FROM Emp1 WHERE Name LIKE '%M%';
SELECT Name FROM Emp1 WHERE Age IN (21, 23);

-- OUTPUT: SELECT * FROM Emp1
-- +-------+---------+-----------+-----+-----------+
-- | EmpID | Name    | Country   | Age | mob       |
-- +-------+---------+-----------+-----+-----------+
-- |     1 | Shubham | India     |  23 | 738479734 |
-- |     2 | Aman    | Australia |  21 | 436789555 |
-- |     3 | Naveen  | Sri lanka |  24 |  34873847 |
-- |     4 | Aditya  | Austria   |  21 | 328440934 |
-- |     5 | Nishant | Spain     |  22 |  73248679 |
-- +-------+---------+-----------+-----+-----------+
-- OUTPUT: Age = 24 -> 3 Naveen Sri lanka 24 34873847
-- OUTPUT: Age > 21
-- +-------+---------+-----------+
-- | EmpID | Name    | Country   |
-- +-------+---------+-----------+
-- |     1 | Shubham | India     |
-- |     3 | Naveen  | Sri lanka |
-- |     5 | Nishant | Spain     |
-- +-------+---------+-----------+
-- OUTPUT: BETWEEN 22 AND 24 -> Shubham(23), Naveen(24), Nishant(22)
-- OUTPUT: LIKE 'S%'  -> Shubham
-- OUTPUT: LIKE '%M%' -> Shubham, Aman
-- OUTPUT: IN (21,23) -> Shubham, Aman, Aditya

-- ---- Part B: Aggregate functions ----
CREATE TABLE Products (
  product_id INT PRIMARY KEY,
  name VARCHAR(50),
  quantity_in_stock INT,
  unit_price DECIMAL(5,2)
);
INSERT INTO Products VALUES
(1, 'Foam Dinner Plate', 70, 1.21),
(2, 'Pork - Bacon,back Peameal', 49, 4.65),
(3, 'Lettuce - Romaine, Heart', 38, 3.35),
(4, 'Brocolinni - Gaylan, Chinese', 90, 4.53),
(5, 'Sauce - Ranch Dressing', 94, 1.63),
(6, 'Petit Baguette', 14, 2.39),
(7, 'Sweet Pea Sprouts', 98, 3.29),
(8, 'Island Oasis - Raspberry', 26, 0.74),
(9, 'Longan', 67, 2.26),
(10, 'Broom - Push', 6, 1.09);

SELECT COUNT(product_id) AS total_products FROM Products;
SELECT COUNT(product_id) AS price_above_4 FROM Products WHERE unit_price > 4;
SELECT SUM(unit_price) AS total_price FROM Products;
SELECT AVG(quantity_in_stock) AS avg_stock FROM Products;
SELECT MIN(quantity_in_stock) AS min_stock FROM Products;
SELECT MAX(quantity_in_stock) AS max_stock FROM Products;

-- OUTPUT:
-- +----------------+---------------+-------------+-----------+-----------+-----------+
-- | total_products | price_above_4 | total_price | avg_stock | min_stock | max_stock |
-- +----------------+---------------+-------------+-----------+-----------+-----------+
-- |             10 |             2 |       25.14 |   55.2000 |         6 |        98 |
-- +----------------+---------------+-------------+-----------+-----------+-----------+
-- (MySQL prints each of the 6 queries as its own one-row table)

